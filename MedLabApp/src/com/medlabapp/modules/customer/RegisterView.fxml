<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.medlabapp.modules.customer.RegisterController">
    <center>
        <VBox alignment="CENTER" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="50" left="50" right="50" top="50" />
            </padding>
            <VBox alignment="CENTER" maxWidth="420" spacing="15" styleClass="card">
                <padding>
                    <Insets bottom="30" left="30" right="30" top="30" />
                </padding>

              <VBox alignment="CENTER" spacing="5">
                    <Label style="-fx-text-fill: #2E7D32; -fx-font-size: 36px;" text="⬡" />
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #212529; -fx-font-size: 20px;" text="Sante Diagnostics LIMS" />
                </VBox>

                <Label styleClass="text-header" text="Create Account" />
                <Label styleClass="text-muted" text="Register as a new patient below." wrapText="true" />

      <TextField fx:id="nameField" promptText="Full Name" styleClass="text-field" />
                <TextField fx:id="emailField" promptText="Email Address" styleClass="text-field" />
                <PasswordField fx:id="passwordField" promptText="Password" styleClass="text-field" />
                <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" styleClass="text-field" />

                 <Label fx:id="messageLabel" minHeight="25" styleClass="text-danger" text="" wrapText="true" />

                 <Button fx:id="registerBtn" maxWidth="1.7976931348623157E308" onAction="#handleRegister" styleClass="button-primary" text="Create Account" />

                <HBox alignment="CENTER">
                    <Button onAction="#handleBackToLogin" style="-fx-padding: 8px 15px;" styleClass="button-secondary" text="Back to Login" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
