<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medlabapp.login.ResetPasswordController">
    <center>
        <VBox alignment="CENTER" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="50" left="50" right="50" top="50"/>
            </padding>
            <VBox styleClass="card" alignment="CENTER" maxWidth="420" spacing="15">
                <padding>
                    <Insets bottom="30" left="30" right="30" top="30"/>
                </padding>

           
                <VBox alignment="CENTER" spacing="5">
                    <Label text="⬡" style="-fx-text-fill: #2E7D32; -fx-font-size: 36px;"/>
                    <Label text="Sante Diagnostics LIMS"
                           style="-fx-font-weight: bold; -fx-text-fill: #212529; -fx-font-size: 20px;"/>
                </VBox>

                <Label styleClass="text-header" text="Enter Reset Code"/>
                <Label styleClass="text-muted" wrapText="true"
                       text="Check your email for the 6-digit code. It expires in 15 minutes."/>

                <TextField fx:id="codeField" promptText="6-digit reset code" styleClass="text-field"/>
                
                
                
                
                
                <StackPane alignment="CENTER_RIGHT">
    <PasswordField fx:id="passwordField" promptText="New password" styleClass="text-field"/>
    
    <TextField fx:id="passwordField" promptText="New password" styleClass="text-field" visible="false"/>
    
    <ToggleButton fx:id="togglePasswordBtn" text="👁" 
                  style="-fx-background-color: transparent; -fx-text-fill: #6C757D; -fx-cursor: hand;" 
                  onAction="#togglePasswordVisibility"/>
</StackPane>
                
                
                <StackPane alignment="CENTER_RIGHT">
    <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" styleClass="text-field"/>
    
    <TextField fx:id="confirmPasswordField" promptText="Confirm new password" styleClass="text-field" visible="false"/>
    
    <ToggleButton fx:id="togglePasswordBtn" text="👁" 
                  style="-fx-background-color: transparent; -fx-text-fill: #6C757D; -fx-cursor: hand;" 
                  onAction="#togglePasswordVisibility"/>
</StackPane>
                
                
                
                
                
                
                
                <Label fx:id="messageLabel" text="" wrapText="true" minHeight="25"/>

                <Button text="Reset Password"
                        maxWidth="1.7976931348623157E308"
                        styleClass="button-primary"
                        onAction="#handleResetPassword"/>

                <HBox alignment="CENTER">
                    <Button text="Back to Login"
                            styleClass="button-secondary"
                            style="-fx-padding: 8px 15px;"
                            onAction="#handleBackToLogin"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
